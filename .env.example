# APMIX_API_KEY: API key for the APMIX API (OpenAI-compatible).
# Set this as an environment variable / secret in your hosting provider.
APMIX_API_KEY="YOUR_APMIX_API_KEY"

# APP_URL: The URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
